generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== 用户 ==========
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  nickname      String   @default("用户")
  avatar        String?
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conversations     Conversation[]
  messages          Message[]
  moments           Moment[]
  comments          Comment[]
  likes             Like[]
  memories          Memory[]
  voiceProfiles     VoiceProfile[]
  settings          UserSetting?
}

// ========== 对话 ==========
model Conversation {
  id          String   @id @default(cuid())
  userId      String
  title       String   @default("新对话")
  lastMsgAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  summaries   ConversationSummary[]

  @@index([userId])
}

// ========== 消息 ==========
model Message {
  id              String   @id @default(cuid())
  conversationId  String
  userId          String?
  role            String   // "user" | "assistant" | "system"
  content         String   @db.Text
  imageUrl        String?
  voiceUrl        String?
  createdAt       DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([userId])
}

// ========== 朋友圈动态 ==========
model Moment {
  id          String   @id @default(cuid())
  userId      String
  content     String   @db.Text
  images      String[] @default([])
  isAI        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    Comment[]
  likes       Like[]

  @@index([userId])
  @@index([createdAt])
}

// ========== 评论 ==========
model Comment {
  id        String   @id @default(cuid())
  momentId  String
  userId    String
  content   String   @db.Text
  isAI      Boolean  @default(false)
  createdAt DateTime @default(now())

  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([momentId])
}

// ========== 点赞 ==========
model Like {
  id        String   @id @default(cuid())
  momentId  String
  userId    String
  createdAt DateTime @default(now())

  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([momentId, userId])
  @@index([momentId])
}

// ========== 记忆 ==========
model Memory {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "preference" | "fact" | "event" | "summary"
  content     String   @db.Text
  tags        String[] @default([])
  importance  Float    @default(0.5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

// ========== 对话摘要 ==========
model ConversationSummary {
  id              String   @id @default(cuid())
  conversationId  String
  content         String   @db.Text
  msgCount        Int
  createdAt       DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ========== 语音配置 ==========
model VoiceProfile {
  id          String   @id @default(cuid())
  userId      String
  name        String
  voiceType   String   @default("preset")  // "preset" | "cloned"
  voiceId     String?
  audioUrl    String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ========== 用户设置 ==========
model UserSetting {
  id              String   @id @default(cuid())
  userId          String   @unique
  theme           String   @default("default")
  fontSize        String   @default("medium")  // "small" | "medium" | "large"
  chatBackground  String?
  avatar          String?
  voiceProfileId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
