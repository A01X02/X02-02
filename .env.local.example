# ===== 数据库（腾讯云 PostgreSQL）=====
DATABASE_URL="postgresql://用户名:密码@连接地址:端口/数据库名?schema=public"
# 示例: postgresql://postgres:yourpassword@pgm-xxx.sql.tencentcdb.com:5432/aichatbot?schema=public

# ===== 认证（NextAuth）=====
NEXTAUTH_SECRET="用 openssl rand -base64 32 生成一个随机字符串"
NEXTAUTH_URL="http://localhost:3000"

# ===== 腾讯云 COS（对象存储）=====
COS_SECRET_ID="你的腾讯云 SecretId"
COS_SECRET_KEY="你的腾讯云 SecretKey"
COS_BUCKET="ai-chatbot-1234567890"
COS_REGION="ap-guangzhou"

# ===== 火山引擎豆包 API =====
DOUBAO_API_KEY="你的豆包 API Key"
DOUBAO_MODEL_ID="ep-xxxxxxxxxxxxx"
DOUBAO_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# ===== 火山引擎 TTS 语音 =====
TTS_APP_ID="你的火山引擎语音 AppID"
TTS_ACCESS_TOKEN="你的火山引擎语音 Token"
TTS_CLUSTER="volcano_tts"
